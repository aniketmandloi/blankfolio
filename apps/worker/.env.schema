# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Worker runtime role: application tables and the pg-boss schema. Use a direct (non-pooler) connection.
# @type=string(minLength=1)
DATABASE_URL=

# Must match the API's value. A source whose required route has no price is disabled.
# @required=false @type=string(minLength=2)
LITERATURE_SOURCE_PRICES=

# Must match the API's value: US dollars per UTC day per source, e.g. {"openalex":1}.
# @required=false @type=string(minLength=2)
LITERATURE_SOURCE_QUOTAS=

# OpenAlex API key from https://openalex.org/settings/api, sent only as a bearer header by the worker.
# Without it OpenAlex searches fail visibly with "credentials-missing"; the API never needs it.
# @required=false @type=string(minLength=1)
OPENALEX_API_KEY=

# Offer the fixture literature sources, which fabricate papers. Must match the API. Only for tests
# and local development; leave unset in every deployment so researchers never receive fixture results.
# @required=false @type=boolean
LITERATURE_FIXTURE_SOURCES=

# Only for `queue:migrate`: a role allowed to create and upgrade the pg-boss schema.
# @required=false @type=string(minLength=1)
DATABASE_MIGRATION_URL=
