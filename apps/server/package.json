{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/start.ts --outfile server",
		"dev": "tsx watch src/start.ts",
		"start": "node dist/start.mjs",
		"env:generate": "varlock codegen",
		"pilot:access": "tsx src/pilot-access.ts",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"test": "cd ../.. && pnpm test"
	},
	"dependencies": {
		"@blankfolio/api": "workspace:*",
		"@blankfolio/auth": "workspace:*",
		"@blankfolio/db": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@hono/trpc-server": "^0.4.2",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@blankfolio/config": "workspace:*",
		"@trpc/client": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "^0.23.0",
		"tsx": "catalog:",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2"
	}
}
