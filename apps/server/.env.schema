# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api/auth", undefined)

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Local fixture file receiving verification/recovery links as JSON lines instead of mail.
# Unset disables delivery; rejected in production.
# @required=false @type=string(minLength=1)
AUTH_MAIL_OUTBOX=

# Resend API key for verification and recovery mail; unset keeps delivery disabled.
# @required=false @type=string(startsWith=re_)
RESEND_API_KEY=

# Sender for auth mail; defaults to Resend's onboarding sender, which only
# delivers to the Resend account owner until a domain is verified.
# @required=false @sensitive=false @type=string(minLength=3)
AUTH_MAIL_FROM=

# Direct Neon connection for migrations; never use the pooler for DDL.
# @required=false @type=string(minLength=1)
DATABASE_MIGRATION_URL=

# Metered literature route prices as JSON, in US dollars per request, e.g.
# {"fixture-metered":0.02,"openalex-search":0.001,"openalex-filter":0.0001}.
# A source whose required route has no price is disabled; other sources stay available.
# @required=false @type=string(minLength=2)
LITERATURE_SOURCE_PRICES=

# Deployment-wide provider quotas as JSON, in US dollars per UTC day per source, e.g. {"openalex":1}.
# A source that needs a quota (OpenAlex) is disabled without one. Must match the worker's value.
# @required=false @type=string(minLength=2)
LITERATURE_SOURCE_QUOTAS=

# Offer the fixture literature sources, which fabricate papers. Only for tests and local development;
# leave unset in every deployment so researchers never receive fixture results.
# @required=false @type=boolean
LITERATURE_FIXTURE_SOURCES=
