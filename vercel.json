{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "nextjs",
			"installCommand": "cd ../.. && pnpm install",
			"buildCommand": "NEXT_PUBLIC_SERVER_URL=/api pnpm run build"
		},
		"server": {
			"root": "apps/server",
			"framework": "hono",
			"entrypoint": "src/index.ts",
			"installCommand": "cd ../.. && pnpm install",
			"rewrites": [
				{
					"source": "/api/trpc/:path(.*)",
					"destination": "/trpc/:path"
				}
			]
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "server"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "web"
			}
		}
	]
}
